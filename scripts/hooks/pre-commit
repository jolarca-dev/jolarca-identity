#!/bin/bash
# pre-commit hook — jolarca-identity
#
# Compensating control for GitHub Free limitation: server-side branch
# protection and required status checks are unavailable. This hook scans
# staged content with gitleaks before every commit so secrets never enter
# the history in the first place.
#
# Install: scripts/install-hooks.sh
# Requires: gitleaks (https://github.com/gitleaks/gitleaks#installing)
#
# SOC 2 CC6.1 · ISO 27001:2022 A.5.17 · PCI-DSS Req 8

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- Pre-flight: is gitleaks installed? ---
if ! command -v gitleaks &>/dev/null; then
  echo "⚠  gitleaks not found — skipping secret scan"
  echo "   Install: https://github.com/gitleaks/gitleaks#installing"
  exit 0
fi

echo "🔍 Running gitleaks secret scan (pre-commit, staged files)..."

# `gitleaks protect --staged` scans the staging area only.
if gitleaks protect --staged --source "$REPO_ROOT" --no-banner --redact 2>&1; then
  echo "✓  gitleaks: no secrets detected in staged changes"
  exit 0
else
  echo ""
  echo "✗  gitleaks: SECRETS DETECTED — commit blocked"
  echo "   Remove the secret, rotate the credential, and try again."
  echo "   If this is a false positive, add a .gitleaksignore entry."
  exit 1
fi
